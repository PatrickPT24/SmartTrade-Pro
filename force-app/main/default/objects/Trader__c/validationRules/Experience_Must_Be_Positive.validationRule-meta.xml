<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Experience_Must_Be_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>Experience__c  &lt; 0</errorConditionFormula>
    <errorDisplayField>Experience__c</errorDisplayField>
    <errorMessage>Experience cannot be negative.</errorMessage>
</ValidationRule>
