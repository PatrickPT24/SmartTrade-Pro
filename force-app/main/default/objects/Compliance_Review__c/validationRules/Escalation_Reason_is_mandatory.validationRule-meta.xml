<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Escalation_Reason_is_mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
Escalation_Required__c,
ISBLANK(Escalation_Reason__c)
)</errorConditionFormula>
    <errorDisplayField>Escalation_Reason__c</errorDisplayField>
    <errorMessage>Escalation Reason is mandatory if Escalation Required is checked.</errorMessage>
</ValidationRule>
