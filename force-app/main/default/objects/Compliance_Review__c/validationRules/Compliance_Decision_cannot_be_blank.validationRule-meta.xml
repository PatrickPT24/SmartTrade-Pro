<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Compliance_Decision_cannot_be_blank</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Review_Status__c,&quot;Closed&quot;),
ISBLANK(TEXT(Compliance_Decision__c))
)</errorConditionFormula>
    <errorDisplayField>Compliance_Decision__c</errorDisplayField>
    <errorMessage>Compliance Decision cannot be blank.</errorMessage>
</ValidationRule>
