<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Portfolio_Esists</name>
        <label>Portfolio Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Portfolio</defaultConnectorLabel>
        <rules>
            <name>Portfolio_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Portfolio.Portfolio_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Portfolio</targetReference>
            </connector>
            <label>Portfolio Found?</label>
        </rules>
    </decisions>
    <description>When a trade is successfully executed, the trader&apos;s portfolio should automatically update.</description>
    <environments>Default</environments>
    <formulas>
        <name>NewCurrentValue</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Portfolio.Current_Value__c}+{!$Record.Execution_Value__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NewDailyPnL</name>
        <dataType>Number</dataType>
        <expression>{!Get_Portfolio.Daily_P_L__c}+{!$Record.Execution_Value__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NewMonthlyPnL</name>
        <dataType>Number</dataType>
        <expression>{!Get_Portfolio.Monthly_P_L__c}+{!$Record.Execution_Value__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Auto Update Portfolio {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Auto Update Portfolio</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Portfolio</name>
        <label>Get Portfolio</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Portfolio_Esists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Trader__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Trade_Request.Trader__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Portfolio__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Trade_Request</name>
        <label>Get Trade Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Portfolio</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Trade_Request__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Trade_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Portfolio</name>
        <label>Update Portfolio</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Current_Value__c</field>
            <value>
                <elementReference>NewCurrentValue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Daily_P_L__c</field>
            <value>
                <elementReference>NewDailyPnL</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Monthly_P_L__c</field>
            <value>
                <elementReference>NewMonthlyPnL</elementReference>
            </value>
        </inputAssignments>
        <object>Portfolio__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Trade_Request</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Execution_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Filled</stringValue>
            </value>
        </filters>
        <object>Trade_Execution__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
